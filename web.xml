<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://jakarta.ee/xml/ns/jakartaee
                             http://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

        <context-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>/WEB-INF/applicationContext.xml</param-value>
        </context-param>

        <context-param>
            <param-name>packageToScan</param-name>
            <param-value>Presentation</param-value>
        </context-param>

        <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
        </listener>

        

        <context-param>
            <param-name>viewPrefix</param-name>
            <param-value>/WEB-INF/jsp/</param-value>
        </context-param>

        <context-param>
            <param-name>viewSuffix</param-name>
            <param-value>.jsp</param-value>
        </context-param>

        <listener>
            <listener-class>Presentation.RequestControllerListener</listener-class>
        </listener>

        <servlet>
            <servlet-name>FrontControllerServlet</servlet-name>
            <servlet-class>Presentation.FrontControllerServlet</servlet-class>

            <init-param>
                <param-name>authSessionKey</param-name>
                <param-value>userConnecte</param-value>
            </init-param>
            <init-param>
                <param-name>loginPage</param-name>
                <param-value>formLogin</param-value>
            </init-param>
            <init-param>
                <param-name>roleSession</param-name>
                <param-value>roleUser</param-value>
            </init-param>
        </servlet>

    <servlet-mapping>
        <servlet-name>FrontControllerServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    

  
</web-app>
